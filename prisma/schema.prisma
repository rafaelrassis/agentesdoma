generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // migrate deploy usa esta pra acquire do advisory lock — a DATABASE_URL normal
  // aponta pro endpoint "-pooler" do Neon, que não segura lock de sessão de forma
  // confiável (é isso que causava os P1002 "timed out trying to acquire a postgres
  // advisory lock"). Aponte DIRECT_DATABASE_URL pro mesmo banco, só sem "-pooler"
  // no host.
  directUrl = env("DIRECT_DATABASE_URL")
}

enum OrderStatus {
  pending
  claimed
  running
  done
  failed
}

enum RunStatus {
  running
  completed
  failed
}

enum ExecutionTarget {
  local
  cloud
}

model Order {
  id        String          @id @default(cuid())
  agent     String
  prompt    String
  target    ExecutionTarget @default(local)
  model     String?
  status    OrderStatus     @default(pending)
  result    String?
  createdAt DateTime        @default(now())
  claimedAt DateTime?
  finishedAt DateTime?
}

model Run {
  id         String    @id @default(cuid())
  agent      String
  status     RunStatus @default(running)
  summary    String?
  orderId    String?
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
}

model Snapshot {
  id        String   @id @default(cuid())
  date      String
  data      Json
  createdAt DateTime @default(now())

  @@index([date])
}

model Report {
  id        String   @id @default(cuid())
  agent     String
  date      String
  path      String
  content   String
  createdAt DateTime @default(now())

  @@unique([agent, path])
}

model Routine {
  id            String          @id @default(cuid())
  agent         String
  prompt        String
  target        ExecutionTarget @default(local)
  model         String?
  frequencyDays Int             @default(1)
  enabled       Boolean         @default(true)
  lastRunAt     DateTime?
  createdAt     DateTime        @default(now())
}

model CloudSettings {
  id                  Int       @id @default(1)
  coletorCloudEnabled Boolean   @default(false)
  shopeeStorageState  Json?
  shopeeSessionSavedAt DateTime?
  updatedAt           DateTime  @updatedAt
}

model WorkerHeartbeat {
  target     String   @id
  lastSeenAt DateTime @updatedAt
}

model ShopeeLogin {
  target    String   @id
  loggedIn  Boolean?
  detail    String?
  checkedAt DateTime @updatedAt
}

enum TaskColumn {
  backlog
  proximo_ciclo
  fazendo
  feito
}

model Task {
  id        String     @id @default(cuid())
  title     String
  detail    String?
  column    TaskColumn @default(backlog)
  position  Int        @default(0)
  createdBy String     @default("rafael")
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@unique([title, createdBy])
}
